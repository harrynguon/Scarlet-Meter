<Project Sdk="Microsoft.NET.Sdk">

  <!-- Guards the upstream boundary and the engine's mapping over upstream, and tests the world-events module and
       its independence. Runs without Npcap. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.1" />
    <!-- FakeTimeProvider: drives the release checker's six-hour window and ten-second timeout without waiting. -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/ScarletMeter.Engine/ScarletMeter.Engine.csproj" />
    <ProjectReference Include="../../src/ScarletMeter.App/ScarletMeter.App.csproj" />
    <ProjectReference Include="../../src/ScarletMeter.WorldEvents/ScarletMeter.WorldEvents.csproj" />
  </ItemGroup>

</Project>
