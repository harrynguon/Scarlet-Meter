<Project Sdk="Microsoft.NET.Sdk">

  <!-- Guards the upstream boundary and the engine's mapping over upstream. Runs without Npcap. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.20348.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/ScarletMeter.Engine/ScarletMeter.Engine.csproj" />
    <ProjectReference Include="../../src/ScarletMeter.App/ScarletMeter.App.csproj" />
  </ItemGroup>

</Project>
