<div class="overlay" data-window="overlay" style="@PanelStyle">
    <header class="ov-header" @onmousedown="OnHeaderMouseDown">
        <div class="ov-title">
            @if (snapshot.Target is { } target)
            {
                <span class="target-name" title="@target.Name">@target.Name</span>
                <span class="target-hp">@Compact.Number(target.HpCurrent) / @Compact.Number(target.HpTotal)</span>
            }
            else
            {
                <span class="target-name muted">@StatusText</span>
            }
        </div>
        <div class="ov-actions" @onmousedown:stopPropagation="true">
            <button type="button" class="icon-btn" title="Drop the current fight" @onclick="Reset">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8a4.5 4.5 0 1 0 1.3-3.2" /><path d="M3.2 2.6v2.6h2.6" /></svg>
            </button>
            <button type="button" class="icon-btn" title="History" @onclick="Windows.OpenHistory">
                <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="5.8" /><path d="M8 4.8V8l2.2 1.4" /></svg>
            </button>
            <button type="button" class="icon-btn" title="Settings" @onclick="Windows.OpenSettings">
                <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="2.2" /><path d="M8 1.8v1.6M8 12.6v1.6M14.2 8h-1.6M3.4 8H1.8M12.4 3.6l-1.1 1.1M4.7 11.3l-1.1 1.1M12.4 12.4l-1.1-1.1M4.7 4.7 3.6 3.6" /></svg>
            </button>
            <button type="button" class="icon-btn" title="Minimize (the shortcut restores it)" @onclick="Windows.MinimizeOverlay">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8.5h9" /></svg>
            </button>
            <button type="button" class="icon-btn close" title="Close Scarlet Meter" @onclick="Windows.CloseMeter">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 4 8 8M12 4l-8 8" /></svg>
            </button>
        </div>
    </header>

    <div class="hp-bar @(snapshot.Target is null ? "idle" : "")">
        <div class="hp-fill" style="width:@Compact.Percent(snapshot.Target?.HpPercent ?? 0)"></div>
    </div>

    <div class="ov-totals">
        <span title="Combat duration">@Compact.Duration(snapshot.Duration)</span>
        <span title="Party DPS" class="accent">@Compact.Number(snapshot.PartyDps)/s</span>
        <span class="ping @PingLevel.Of(ping)" title="Ping">
            <i></i><i></i><i></i>
            @(ping is null ? "-- ms" : $"{ping} ms")
        </span>
    </div>

    <ul class="rows">
        @foreach (var player in Visible)
        {
            <li class="row @(player.IsUser ? "me" : "")" @key="player.Id" title="Open this player's breakdown" @onclick="() => Windows.OpenPlayerDetails(player.Id)">
                <div class="fill @FillClass(player)" style="width:@Compact.Percent(BarPercent(player))"></div>
                @if (WebAssetHosts.ClassIconUrl(player.ClassId) is { } icon)
                {
                    <span class="class-icon" style="background-image:url('@icon')" title="@player.ClassName"></span>
                }
                <span class="name" title="@DisplayName(player)">@DisplayName(player)</span>
                @if (appearance.ShowDeaths && player.Deaths > 0)
                {
                    <span class="deaths" title="Deaths">&#x1F480; @player.Deaths</span>
                }
                <span class="num">@Compact.Number(player.TotalDamage)</span>
                <span class="num dps">@Compact.Number(player.Dps)/s</span>
                <span class="num pct">@Compact.Percent(player.DamageShare)</span>
            </li>
        }
    </ul>

    @if (Updates.Visible is { } release)
    {
        <div class="update-note" title="Scarlet Meter is built on RATmeter @release.PinnedRelease. Update the upstream pin and reinstall to get its fixes (Settings, About).">
            <span class="update-dot"></span>
            <span class="update-text">RATmeter @release.Tag is out</span>
            <button type="button" class="link-btn" @onclick="() => Windows.OpenReleasePage(release.ReleasePage)">Release notes</button>
            <button type="button" class="icon-btn small" title="Hide until the next release" aria-label="Hide until the next release" @onclick="() => Updates.Dismiss(release)">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4.5 4.5 7 7M11.5 4.5l-7 7" /></svg>
            </button>
        </div>
    }
    <AlertStrip View="Alerts.Current" Now="Clock.GetUtcNow()" />
</div>
