@*
    The overlay: a header (Scarlet's face ringed by the fight's state, the state and duration, buttons), the target's card (name, HP, its bar and the
    "Kill in" estimate), totals, one row per player and the notices below. With "Bar effects" on (.fx), the bars
    shine, each bar carries its class's animated effect (BarEffect; the player's own at full strength, the others
    fainter, or only the player's when "Effects on every bar" is off), and js/overlay-fx.js glides rows to their
    new places when the order changes.
*@
<div class="overlay @OverlayClass" data-window="overlay" style="@PanelStyle">
    <header class="ov-header" @onmousedown="OnHeaderMouseDown">
        <div class="ov-title">
            @* Scarlet's face, always there; its ring takes the fight's state (AvatarClass, app.css .ov-avatar). *@
            <span class="ov-avatar @AvatarClass" aria-hidden="true"></span>
            @if (snapshot.Target is { } fighting)
            {
                <span class="state-text">@StateText(fighting)</span>
                <span class="state-time" title="Combat duration">@Compact.Duration(snapshot.Duration)</span>
            }
            else
            {
                <span class="target-name muted">@StatusText</span>
            }
        </div>
        <div class="ov-actions" @onmousedown:stopPropagation="true">
            <button type="button" class="icon-btn" title="Drop the current fight" @onclick="Reset">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8a4.5 4.5 0 1 0 1.3-3.2" /><path d="M3.2 2.6v2.6h2.6" /></svg>
            </button>
            @* World-event notices on or off in one click (the same switch as Settings, Alerts); struck through when off. *@
            <button type="button" class="icon-btn @(alertSettings.Enabled ? "" : "off")" aria-label="World-event alerts" aria-pressed="@(alertSettings.Enabled ? "true" : "false")"
                    title="@(alertSettings.Enabled ? "Hide world-event alerts" : "Show world-event alerts")" @onclick="ToggleAlerts">
                <svg viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M4.3 11.2V7.3a3.7 3.7 0 0 1 7.4 0v3.9l1.2 1.2H3.1z" /><path d="M6.6 13.7a1.5 1.5 0 0 0 2.8 0" />
                    @if (!alertSettings.Enabled)
                    {
                        <path d="m2.6 2.6 10.8 10.8" />
                    }
                </svg>
            </button>
            @* World-boss timers from aion2timers.com, in a window of their own (Windows/BossTimersWindow). *@
            <button type="button" class="icon-btn" title="Boss timers (aion2timers.com)" @onclick="Windows.OpenBossTimers">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 2h7M4.5 14h7" /><path d="M5.3 2.2c0 3.3 5.4 3 5.4 5.8s-5.4 2.5-5.4 5.8M10.7 2.2c0 3.3-5.4 3-5.4 5.8s5.4 2.5 5.4 5.8" /></svg>
            </button>
            <button type="button" class="icon-btn" title="History" @onclick="Windows.OpenHistory">
                <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="5.8" /><path d="M8 4.8V8l2.2 1.4" /></svg>
            </button>
            <button type="button" class="icon-btn" title="Settings" @onclick="Windows.OpenSettings">
                <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="2.2" /><path d="M8 1.8v1.6M8 12.6v1.6M14.2 8h-1.6M3.4 8H1.8M12.4 3.6l-1.1 1.1M4.7 11.3l-1.1 1.1M12.4 12.4l-1.1-1.1M4.7 4.7 3.6 3.6" /></svg>
            </button>
            <button type="button" class="icon-btn" title="Minimize (the shortcut restores it)" @onclick="Windows.MinimizeOverlay">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8.5h9" /></svg>
            </button>
            <button type="button" class="icon-btn close" title="Close Scarlet Meter" @onclick="Windows.CloseMeter">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 4 8 8M12 4l-8 8" /></svg>
            </button>
        </div>
    </header>

    @if (snapshot.Target is { } target)
    {
        <section class="target-card @(target.IsBoss ? "boss" : "")" aria-label="Target">
            <div class="target-top">
                @if (target.IsBoss)
                {
                    @* A crown, Scarlet's own boss mark (Harry's pick): unlike other meters' skull, and unlike the deaths' skull on a row. *@
                    <svg class="target-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M2.6 11.6 2 5.2l3.3 2.7L8 3.4l2.7 4.5L14 5.2l-.6 6.4Z" /><path d="M3.2 13.9h9.6" /></svg>
                }
                <span class="target-name" title="@target.Name">@target.Name</span>
                @* The absolute HP gives way to the name on a narrow card (app.css, .target-card's container query). *@
                <span class="target-hp"><span class="hp-abs">@Compact.Number(target.HpCurrent) / @Compact.Number(target.HpTotal) · </span><b>@Compact.Percent(target.HpPercent)</b></span>
                @* On the same line, and only once there is an estimate, so the card stays one line and a bar. *@
                @if (killIn is { } left)
                {
                    <span class="target-kill" title="Kill in, at the pace its HP fell over the last @((int)KillTimer.Window.TotalSeconds) seconds">Kill in <b>@Compact.Duration(left)</b></span>
                }
            </div>
            <div class="target-bar">
                <div class="target-fill" style="width:@Compact.Percent(target.HpPercent)"></div>
            </div>
        </section>
    }

    <div class="ov-totals">
        <span title="Party DPS" class="accent">@Compact.Number(snapshot.PartyDps)/s</span>
        @* Odyle energy left of the ping, once the game has sent it (a crystal of Scarlet's own, not the game's art). *@
        @if (appearance.ShowOdyleEnergy && odyle is { } energy)
        {
            <span class="odyle" title="Odyle energy: basic (+charged)">
                <svg class="odyle-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.6 12.6 6 8 14.4 3.4 6Z" /><path d="M3.4 6h9.2M6.3 6 8 14.4 9.7 6M6.3 6 8 1.6 9.7 6" /></svg>
                <span class="odyle-basic">@OdyleText.Basic(energy)</span>
                <span class="odyle-charged">@OdyleText.Charged(energy)</span>
            </span>
        }
        <span class="ping @PingLevel.Of(ping)" title="Ping">
            <i></i><i></i><i></i>
            @(ping is null ? "-- ms" : $"{ping} ms")
        </span>
    </div>

    <ul class="rows">
        @foreach (var player in Visible)
        {
            <li class="row @(player.IsUser ? "me" : "")" @key="player.Id" title="Open this player's breakdown" @onclick="() => Windows.OpenPlayerDetails(player.Id)">
                <div class="fill @FillClass(player)" style="width:@Compact.Percent(BarPercent(player))">
                    @if (appearance.BarEffects && (player.IsUser || appearance.EffectsOnEveryBar))
                    {
                        <BarEffect ClassId="player.ClassId" />
                    }
                </div>
                @if (WebAssetHosts.ClassIconUrl(player.ClassId) is { } icon)
                {
                    <span class="class-icon" style="background-image:url('@icon')" title="@player.ClassName"></span>
                }
                <span class="who">
                    <span class="name" title="@DisplayName(player)">@DisplayName(player)</span>
                    @if (appearance.ShowCombatPower && player.CombatPower > 0)
                    {
                        <span class="cp" title="Combat power @player.CombatPower.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)">@Compact.Number(player.CombatPower)</span>
                    }
                </span>
                @if (appearance.ShowDeaths && player.Deaths > 0)
                {
                    <span class="deaths" title="Deaths">&#x1F480; @player.Deaths</span>
                }
                <span class="num dps">@Compact.Number(player.Dps)/s</span>
                @* The share over the total damage, which is smaller and dimmer: the one to look at less (app.css). *@
                <span class="share">
                    <span class="num pct" title="Share of the damage">@Compact.Percent(player.DamageShare)</span>
                    <span class="num total" title="Total damage">@Compact.Number(player.TotalDamage)</span>
                </span>
            </li>
        }
    </ul>

    @if (Updates.Visible is { } release)
    {
        <div class="update-note" title="Scarlet Meter is built on RATmeter @release.PinnedRelease. Update the upstream pin and reinstall to get its fixes (Settings, About).">
            <span class="update-dot"></span>
            <span class="update-text">RATmeter @release.Tag is out</span>
            <button type="button" class="link-btn" @onclick="() => Windows.OpenReleasePage(release.ReleasePage)">Release notes</button>
            <button type="button" class="icon-btn small" title="Hide until the next release" aria-label="Hide until the next release" @onclick="() => Updates.Dismiss(release)">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4.5 4.5 7 7M11.5 4.5l-7 7" /></svg>
            </button>
        </div>
    }
    @* Always rendered, held empty while the notices stand aside for a boss fight (NoticesHeld), so its live region
       survives the fight. Open or closed is the player's choice, kept in settings. *@
    <AlertStrip View="Alerts.Current" Now="Clock.GetUtcNow()" Expanded="alertSettings.NoticesExpanded" ExpandedChanged="SetNoticesExpanded" Held="NoticesHeld" />
</div>
