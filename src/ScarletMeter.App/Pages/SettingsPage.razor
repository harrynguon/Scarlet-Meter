<div class="tool settings" data-window="settings">
    <nav class="tabs" role="tablist">
        @foreach (var tab in Tabs)
        {
            <button type="button" role="tab" class="tab @(tab == current ? "active" : "")" @onclick="() => current = tab">@tab</button>
        }
    </nav>

    @if (Settings.LoadResult.Notice is { } notice)
    {
        <div class="notice">@notice</div>
    }
    @if (Settings.SaveError is { } saveError)
    {
        <div class="notice error">@saveError</div>
    }

    <div class="tab-body">
        @switch (current)
        {
            case "Appearance":
                <section>
                    <h2>Overlay</h2>
                    <RangeSetting Label="Background opacity" Description="Text and bars stay solid."
                                  Value="@S.Appearance.BackgroundOpacity" Min="@AppearanceSettings.MinOpacity" Max="@AppearanceSettings.MaxOpacity" Step="0.05"
                                  Format="@(v => $"{v * 100:0}%")"
                                  ValueChanged="@(v => Change(s => s with { Appearance = s.Appearance with { BackgroundOpacity = v } }))" />
                    <div class="setting picture">
                        <span class="text">
                            <span class="label">Background picture</span>
                            <span class="desc">Shown behind the meter, faded with the background and by its own opacity below. PNG, JPG, GIF, WebP or BMP up to 8 MB.</span>
                        </span>
                        <div class="picture-row">
                            @if (WebAssetHosts.BackgroundUrl(S.Appearance.BackgroundImage) is { } url)
                            {
                                <span class="thumb" style="background-image:url('@url')"></span>
                            }
                            <button type="button" class="btn" @onclick="ChoosePicture">Choose...</button>
                            <button type="button" class="btn" @onclick="RemovePicture" disabled="@(S.Appearance.BackgroundImage is null)">Remove</button>
                        </div>
                        @if (pictureError is not null)
                        {
                            <span class="error">@pictureError</span>
                        }
                    </div>
                    @if (S.Appearance.BackgroundImage is not null)
                    {
                        <RangeSetting Label="Picture opacity" Description="How strongly the picture shows. Lower it if it distracts; text and bars stay solid."
                                      Value="@S.Appearance.PictureOpacity" Min="@AppearanceSettings.MinPictureOpacity" Max="@AppearanceSettings.MaxPictureOpacity" Step="0.05"
                                      Format="@(v => $"{v * 100:0}%")"
                                      ValueChanged="@(v => Change(s => s with { Appearance = s.Appearance with { PictureOpacity = v } }))" />
                    }
                    <RangeSetting Label="Row size" Value="@S.Appearance.RowScale" Min="@AppearanceSettings.MinRowScale" Max="@AppearanceSettings.MaxRowScale" Step="0.05"
                                  Format="@(v => $"{v:0.00}x")"
                                  ValueChanged="@(v => Change(s => s with { Appearance = s.Appearance with { RowScale = v } }))" />
                </section>
                <section>
                    <h2>Player list</h2>
                    <ToggleSetting Label="Class colours" Description="Colour each bar by the player's class."
                                   Value="@S.Appearance.ClassColors" ValueChanged="@(v => Change(s => s with { Appearance = s.Appearance with { ClassColors = v } }))" />
                    <ToggleSetting Label="Relative bars" Description="Bars measure against the top player instead of each player's share."
                                   Value="@S.Appearance.RelativeBars" ValueChanged="@(v => Change(s => s with { Appearance = s.Appearance with { RelativeBars = v } }))" />
                    <ToggleSetting Label="Show deaths" Value="@S.Appearance.ShowDeaths"
                                   ValueChanged="@(v => Change(s => s with { Appearance = s.Appearance with { ShowDeaths = v } }))" />
                    <ToggleSetting Label="Show combat power" Description="Each player's combat power beside their name, once the game has sent it."
                                   Value="@S.Appearance.ShowCombatPower" ValueChanged="@(v => Change(s => s with { Appearance = s.Appearance with { ShowCombatPower = v } }))" />
                    <ToggleSetting Label="Show Odyle energy" Description="Beside the ping: basic energy, then charged in brackets. The game sends it at login, after a server transfer and when it changes, so after starting the meter mid-session it appears with the next of those."
                                   Value="@S.Appearance.ShowOdyleEnergy" ValueChanged="@(v => Change(s => s with { Appearance = s.Appearance with { ShowOdyleEnergy = v } }))" />
                    <ToggleSetting Label="Bar effects" Description="A shine on the bars, each class's animated effect (fire and ice, poison, arrows...), and rows that glide when someone overtakes. Off for plain bars; Windows' reduce-motion setting also stops the motion."
                                   Value="@S.Appearance.BarEffects" ValueChanged="@(v => Change(s => s with { Appearance = s.Appearance with { BarEffects = v } }))" />
                    @if (S.Appearance.BarEffects)
                    {
                        <ToggleSetting Label="Effects on every bar" Description="Every player's bar shows their class's effect, fainter than yours. Off: only your bar does."
                                       Value="@S.Appearance.EffectsOnEveryBar" ValueChanged="@(v => Change(s => s with { Appearance = s.Appearance with { EffectsOnEveryBar = v } }))" />
                    }
                    <ToggleSetting Label="Skill icons" Description="Skill and buff icons in player details load from NC's game-data site, as in RATmeter."
                                   Value="@S.Appearance.SkillIcons" ValueChanged="@(v => Change(s => s with { Appearance = s.Appearance with { SkillIcons = v } }))" />
                    <ToggleSetting Label="Hide player names" Description="Masks every name, yours included, for screenshots and streams."
                                   Value="@S.Appearance.HideNicknames" ValueChanged="@(v => Change(s => s with { Appearance = s.Appearance with { HideNicknames = v } }))" />
                </section>
                break;

            case "Tracking":
                <section>
                    <h2>Fights</h2>
                    <ToggleSetting Label="Boss encounters only" Description="Ignore hits on mobs that are not bosses; training dummies count as bosses. On by default. Applies to new hits."
                                   Value="@S.Fight.BossOnlyCapture" ValueChanged="@(v => Change(s => s with { Fight = s.Fight with { BossOnlyCapture = v } }))" />
                    <ToggleSetting Label="Combine summon damage" Description="Fold a summon's damage into its owner's skill breakdown."
                                   Value="@S.Fight.GroupSummonDamage" ValueChanged="@(v => Change(s => s with { Fight = s.Fight with { GroupSummonDamage = v } }))" />
                    <ToggleSetting Label="Cap dummy parses at one minute" Description="Stop counting hits on a training dummy a minute after the first hit."
                                   Value="@S.Fight.OneMinuteDummyMode" ValueChanged="@(v => Change(s => s with { Fight = s.Fight with { OneMinuteDummyMode = v } }))" />
                </section>
                <section>
                    <h2>History</h2>
                    <label class="setting number">
                        <span class="text">
                            <span class="label">Keep boss fights for</span>
                            <span class="desc">Older fights are removed when the meter starts.</span>
                        </span>
                        <span class="number-field">
                            <input type="number" @key="retentionKey" min="@FightSettings.MinRetentionDays" max="@FightSettings.MaxRetentionDays"
                                   value="@S.Fight.HistoryRetentionDays" @onchange="OnRetentionChanged" /> days
                        </span>
                    </label>
                </section>
                break;

            case "Overlay":
                <section>
                    <h2>Shortcut</h2>
                    <HotkeyBox Label="Show or hide the meter" Description="Works while the game has focus. Needs Ctrl, Alt, Shift or Win unless it is a function key."
                               Value="@S.Overlay.ToggleHotkey" ValueChanged="@(v => Change(s => s with { Overlay = s.Overlay with { ToggleHotkey = v } }))" />
                </section>
                <section>
                    <h2>Window</h2>
                    <p class="hint">Drag the meter by its header and resize it from any edge. Positions and sizes are remembered.</p>
                </section>
                break;

            case "Alerts":
                <section>
                    <h2>World event alerts</h2>
                    <ToggleSetting Label="Show alerts in the meter" Description="A row of event icons at the bottom of the meter. An event's icon lights up with the time left before it starts, and while its entry or portal is open. Hover over an icon to see what it is; click icons for their countdowns."
                                   Value="@S.Alerts.Enabled" ValueChanged="@(v => Change(s => s with { Alerts = s.Alerts with { Enabled = v } }))" />
                    <RangeSetting Label="Warn this long before" Value="@S.Alerts.LeadMinutes" Min="1" Max="60" Step="1"
                                  Format="@(v => $"{v:0} min")"
                                  ValueChanged="@(v => Change(s => s with { Alerts = s.Alerts with { LeadMinutes = (int)Math.Round(v) } }))" />
                    <ToggleSetting Label="Bring the meter back before an event" Description="If the meter is minimized, show it once when an event's warning appears, without taking focus from the game. During a boss fight it waits until the fight is over."
                                   Value="@S.Alerts.RestoreMinimizedMeter" ValueChanged="@(v => Change(s => s with { Alerts = s.Alerts with { RestoreMinimizedMeter = v } }))" />
                    <ToggleSetting Label="Show the next event" Description="When nothing is due, the next event's icon shows the time to its start, dimly."
                                   Value="@S.Alerts.ShowNextEvent" ValueChanged="@(v => Change(s => s with { Alerts = s.Alerts with { ShowNextEvent = v } }))" />
                    <ToggleSetting Label="Hide during boss fights" Description="While you fight a boss (a dungeon boss, a field boss), the notices step aside so the meter has room, also while you hit its adds; they come back once it is down, or about a minute after a wipe. The bell in the meter's header turns them off altogether."
                                   Value="@S.Alerts.HideDuringBossFights" ValueChanged="@(v => Change(s => s with { Alerts = s.Alerts with { HideDuringBossFights = v } }))" />
                </section>
                <section>
                    <h2>Events</h2>
                    @foreach (var rule in EventCatalog.Default)
                    {
                        <ToggleSetting Label="@rule.Name" Description="@($"{EventText.Schedule(rule)} · {NextText(rule)}")"
                                       Value="@S.Alerts.Events.Contains(rule.Id)" ValueChanged="@(v => ToggleEvent(rule.Id, v))" />
                    }
                </section>
                <section>
                    <h2>Server clock</h2>
                    <label class="setting number">
                        <span class="text">
                            <span class="label">Server UTC offset</span>
                            <span class="desc">Asia servers use +9. Times shown here are in this PC's time zone.</span>
                        </span>
                        <span class="number-field">
                            <input type="number" @key="offsetKey" step="0.25" min="@AlertSettings.MinServerOffsetHours" max="@AlertSettings.MaxServerOffsetHours"
                                   value="@(S.Alerts.ServerOffsetHours.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))" @onchange="OnOffsetChanged" /> hours
                        </span>
                    </label>
                    <p class="hint">
                        Event times follow the Global preset ported from the World Companion (A2Tools event data) and are not yet
                        verified on Nezekan. Check the in-game calendar before relying on them.
                    </p>
                </section>
                break;

            case "About":
                <section>
                    <h2>Scarlet Meter @Version</h2>
                    <p class="hint">Capture and decoding come from RATmeter (Kuroukihime/AIon2-Dps-Meter, GPLv3).</p>
                    <div class="setting">
                        <span class="text">
                            <span class="label">Data folder</span>
                            <span class="desc mono">@DataDirectory</span>
                        </span>
                        <button type="button" class="btn" @onclick="Windows.OpenDataFolder">Open</button>
                    </div>
                </section>
                <section>
                    <h2>RATmeter releases</h2>
                    <ToggleSetting Label="Check for new RATmeter releases" Description="Asks GitHub at most every six hours while the meter runs; a slim line in the meter says when one is out. Game patches usually need one."
                                   Value="@S.Updates.CheckUpstreamReleases" ValueChanged="@(v => Change(s => s with { Updates = s.Updates with { CheckUpstreamReleases = v } }))" />
                    <div class="setting">
                        <span class="text">
                            <span class="label">Built on RATmeter @Build.UpstreamRelease</span>
                            <span class="desc">@UpdateStatus</span>
                        </span>
                        @if (Updates.Result is UpstreamReleaseCheckResult.NewerAvailable newer)
                        {
                            <button type="button" class="btn" @onclick="() => Windows.OpenReleasePage(newer.ReleasePage)">Release notes</button>
                        }
                    </div>
                    @if (Updates.Result is UpstreamReleaseCheckResult.NewerAvailable update && Portable)
                    {
                        <p class="hint">
                            To update, close the meter, then run this in PowerShell, with the full path of your Scarlet Meter checkout for
                            &lt;checkout&gt;. It builds and tests the new release and updates &lt;checkout&gt;\portable\ScarletMeter in place,
                            keeping its data folder; then start the meter again from the same ScarletMeter.exe there:
                        </p>
                        <p class="hint mono">&amp; "&lt;checkout&gt;\scripts\Update-Meter.ps1" -Tag @update.Tag</p>
                    }
                    else if (Updates.Result is UpstreamReleaseCheckResult.NewerAvailable installed)
                    {
                        <p class="hint">
                            To update, run these in PowerShell, with the full path of your Scarlet Meter checkout for &lt;checkout&gt;,
                            then start the meter again:
                        </p>
                        <p class="hint mono">&amp; "&lt;checkout&gt;\scripts\Update-Upstream.ps1" -Tag @installed.Tag<br />&amp; "&lt;checkout&gt;\scripts\Install-Meter.ps1"</p>
                    }
                </section>
                break;
        }
    </div>
</div>
