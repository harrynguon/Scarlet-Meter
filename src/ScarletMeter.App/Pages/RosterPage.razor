@using ScarletMeter.App.Roster
@*
    The character roster (Windows/MeterWindows.Roster): a row per character the meter has seen the player log in on, the
    one being played marked. Odyle energy is basic (+charged) and "Full" when basic energy reaches its cap; Nightmare and
    Ascension Trial are entries left (+extra from items). A value marked ≈ is the game's last word plus the recharges
    since (Roster/RosterRules), which logging in on the character corrects. Corridors are the Artifact Corridor entries the
    meter saw since the last Abyss Siege, out of those the character's side can enter (its artifacts held, as the game
    last said on its server). Under each name is the player's own note, saved when Enter is pressed or the box is left.
*@
@{
    var now = Now;
    var calendar = Calendar;
    var rows = Rows(Roster.Characters, Roster.Current, now, calendar, sort, Roster.Artifacts);
    var nextRefill = calendar.NextOdyleRefill(now);
    var lastSiege = calendar.LastSiege(now);
    var nextSiege = calendar.NextSiege(now);
    var kinaTotals = KinaTotals(rows);
}
<div class="tool roster" data-window="roster">
    <div class="roster-head">
        <span class="muted">@rows.Count @(rows.Count == 1 ? "character" : "characters")</span>
        <span class="roster-next" title="Basic Odyle energy refills by 15 every three hours, up to its cap (an estimate)">
            Next +15 Odyle <b>@RosterText.At(nextRefill, now)</b> <span class="muted">in @RosterText.Until(nextRefill - now)</span>
        </span>
        <span class="roster-next" title="Kina across the characters whose inventory the meter has read, as each one's last said">
            @if (kinaTotals.Unknown < rows.Count)
            {
                <text>Kina <b>@DetailFormat.Full(kinaTotals.Kina)</b> <span class="muted">· Bound</span> <b>@DetailFormat.Full(kinaTotals.Bound)</b> <span class="muted">· together</span> <b>@DetailFormat.Full(kinaTotals.Kina + kinaTotals.Bound)</b></text>
                @if (kinaTotals.Unknown > 0)
                {
                    <span class="muted"> (@kinaTotals.Unknown not known)</span>
                }
            }
            else
            {
                <text>Kina <span class="muted">?</span></text>
            }
        </span>
        <span class="roster-next" title="Corridors count from the last Abyss Siege (@RosterText.At(lastSiege, now)) to the next, on the world-event schedule; not checked in the game">
            Corridors reset <b>@RosterText.At(nextSiege, now)</b>
        </span>
        <label class="roster-sort">
            Sort
            <select value="@sort" @onchange="OnSortChanged">
                <option value="@RosterSort.MostPower">Most power</option>
                <option value="@RosterSort.MostOdyle">Most Odyle</option>
                <option value="@RosterSort.FullSoonest">Full soonest</option>
                <option value="@RosterSort.MostKina">Most Kina</option>
                <option value="@RosterSort.Name">Name</option>
                <option value="@RosterSort.LastSeen">Last played</option>
            </select>
        </label>
    </div>
    @if (Roster.Notice is { } notice)
    {
        <div class="notice">@notice</div>
    }
    <div class="tab-body">
        @if (rows.Count == 0)
        {
            <div class="empty-state">No characters yet. Log in on a character with the meter running: the game sends its Odyle energy and entries at login, and the character appears here.</div>
        }
        else
        {
            <table class="grid-table roster-table">
                <thead>
                    <tr>
                        <th></th>
                        <th class="left">Character</th>
                        <th title="Combat power, and gear score (the equipment's item level) below it, as the game last said at login">Power</th>
                        <th title="Basic energy, then charged energy in brackets">Odyle</th>
                        <th class="left" title="When basic energy reaches its cap, if none is spent">Full</th>
                        <th title="Entries left (+extra from recharge items); +@RosterRules.Nightmare.Add a day, up to @RosterRules.Nightmare.Cap">Nightmare</th>
                        <th title="Entries left (+extra from recharge items); +@RosterRules.Ascension.Add a week, up to @RosterRules.Ascension.Cap">Ascension</th>
                        <th title="Artifact Corridors entered since the last Abyss Siege, as the meter saw them, out of those whose artifact your side holds (up to @RosterRules.CorridorsPerSiege), as the game said when you last opened the Abyss map or entered the Abyss; out of @RosterRules.CorridorsPerSiege in italics while that is not known">Corridors</th>
                        <th title="Kina, and Kina (Bound) below it (Engraved Kina, as the game's Korean and Japanese names have it), as the character's inventory last said: at login and at each change">Kina</th>
                        <th class="left">Last played</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in rows)
                    {
                        var character = row.Character;
                        <tr class="@(row.IsCurrent ? "me" : "")" @key="row.Key">
                            <td class="icon-cell">@if (WebAssetHosts.ClassIconUrl(character.ClassId) is { } icon) { <span class="class-icon" style="background-image:url('@icon')"></span> }</td>
                            <td class="left">
                                <div class="who-name">@Name(character) @if (row.IsCurrent) { <span class="badge you">Playing</span> }</div>
                                <div class="who-sub muted">@RosterText.ServerClassAndLevel(character)</div>
                                <input class="roster-note" type="text" maxlength="@RosterNormalizer.MaxNoteLength" placeholder="add a note" aria-label="Note"
                                       title="@NoteTitle(character)" value="@character.Note" @onchange="e => OnNoteChanged(row.Key, e)" />
                            </td>
                            @* Combat power (crossed blades) over gear score (a helmet), each icon Scarlet's own drawing, not the game's art. *@
                            <td>
                                <div class="roster-power @(character.CombatPower > 0 ? "" : "muted")" title="Combat power">
                                    <svg class="cp-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M2.6 2.6 11 11M13.4 2.6 5 11" /><path d="M9.3 12.7 12.7 9.3M3.3 9.3 6.7 12.7" /><path d="M11.7 11.7 13.6 13.6M4.3 11.7 2.4 13.6" /></svg>@RosterText.KnownNumber(character.CombatPower)
                                </div>
                                <div class="roster-power roster-bound" title="@GearScoreTitle(character)">
                                    <svg class="gs-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.5C4.4 1.5 2.8 4 2.8 7.2v5.4L6 14.5V11h4v3.5l3.2-1.9V7.2c0-3.2-1.6-5.7-5.2-5.7ZM4.6 7.4h6.8v1.4H8.8V11H7.2V8.8H4.6Z" /></svg>@RosterText.KnownNumber(character.GearScore)
                                </div>
                            </td>
                            <td>
                                @if (row.Odyle is { } odyle)
                                {
                                    <span class="@(odyle.Gained > 0 ? "estimate" : "")" title="@(odyle.Gained > 0 ? "The game last said " + DetailFormat.Full(character.Odyle!.First) + "; refills since are estimated" : "As the game last said")">@RosterText.Count(odyle)</span>
                                    <span class="odyle-charged"> @RosterText.Extra(character.Odyle!.Second, always: true)</span>
                                }
                                else
                                {
                                    <span class="muted">?</span>
                                }
                            </td>
                            <td class="left">
                                @if (row.Odyle is { Full: true })
                                {
                                    <div class="roster-full">Full</div>
                                }
                                else if (row.FullAt is { } full)
                                {
                                    <div title="@RosterText.At(full, now)">in @RosterText.Until(full - now)</div>
                                }
                                @* 840 is the default (Harry, 2026-10-27), so the list is the two caps; a saved choice of 840 shows as it. *@
                                <select class="roster-cap" title="Basic energy cap: 840 with a membership (the default), 560 without" value="@CapShown(character)" @onchange="e => OnCapChanged(row.Key, e)">
                                    <option value="@OdyleCapChoice.Automatic">cap @RosterRules.MembershipCap</option>
                                    <option value="@OdyleCapChoice.Standard">cap @RosterRules.StandardCap</option>
                                </select>
                            </td>
                            <td>@ContentCell(row.Nightmare, character.Nightmare, RosterRules.Nightmare.Cap)</td>
                            <td>@ContentCell(row.Ascension, character.Ascension, RosterRules.Ascension.Cap)</td>
                            <td title="@CorridorsTitle(row)">@CorridorsCell(row)</td>
                            <td>
                                <div>@KinaCell(character.Kina?.Kina)</div>
                                <div class="roster-bound" title="@BoundKinaTitle(character)">bound @KinaCell(character.Kina?.Bound)</div>
                            </td>
                            @* Last played: the day on a line above the time when it is not today, so a date does not widen the column. *@
                            <td class="left muted" title="@RosterText.At(character.LastSeen, now)">
                                @if (RosterText.Day(character.LastSeen, now) is { Length: > 0 } day)
                                {
                                    <div>@day</div>
                                }
                                <div>@RosterText.Time(character.LastSeen)</div>
                            </td>
                            <td>
                                <button type="button" class="btn small @(IsArmed(row.Key) ? "danger" : "")" title="Remove from the roster, its note with it; the character comes back when you play it" @onclick="() => ClickRemove(row.Key)">@(IsArmed(row.Key) ? "Remove?" : "×")</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
    <footer class="roster-foot muted">
        ≈ marks an estimate: basic Odyle energy +15 every three hours from the daily reset, Nightmare +@RosterRules.Nightmare.Add at each daily reset, Ascension Trial +@RosterRules.Ascension.Add at the weekly reset, none yet checked in the game. Logging in on a character corrects them. Corridors are the Artifact Corridor entries the meter saw since the last Abyss Siege, not estimated: one is missed when the meter is closed, when it misses the corridor's loading, or when the game does not name your character again within @((int)RosterService.CorridorConfirmWindow.TotalMinutes) minutes of a server change. They are out of the corridors whose artifact your side holds, as the game said when you last opened the Abyss map or entered the Abyss on that server since the siege; out of @RosterRules.CorridorsPerSiege, in italics, until then. Kina is as each character's inventory last said, at login and at each change, so it is as of the last time you played them.
        @if (!Roster.CanSave)
        {
            <span> Changes are not saved this run.</span>
        }
    </footer>
</div>

@code {
    // The runs since the siege out of the corridors the side can enter: the bound in italics while that is not known, a
    // dash when the side holds none and none were run.
    private static RenderFragment CorridorsCell(RosterRow row) => builder =>
    {
        if (row is { CorridorsOpen: 0, Corridors: 0 })
        {
            builder.AddMarkupContent(0, "<span class=\"muted\">—</span>");
            return;
        }
        builder.OpenElement(1, "span");
        builder.AddAttribute(2, "class", row.Corridors == 0 ? "muted" : string.Empty);
        builder.AddContent(3, row.Corridors);
        builder.CloseElement();
        builder.OpenElement(4, "span");
        builder.AddAttribute(5, "class", row.CorridorsOpen is null ? "muted roster-open-unknown" : "muted");
        builder.AddContent(6, "/" + (row.CorridorsOpen ?? RosterRules.CorridorsPerSiege));
        builder.CloseElement();
    };

    // A Kina amount, or "?" before the inventory has said.
    private static RenderFragment KinaCell(long? amount) => builder =>
    {
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", amount is null or 0 ? "muted" : string.Empty);
        builder.AddContent(2, amount is { } value ? DetailFormat.Full(value) : "?");
        builder.CloseElement();
    };

    // A content's entries left (+extra) out of its cap, as the game writes it ("6 (+1) /14", "2/3"), marked ≈ when
    // estimated; "?" before the game has sent it.
    private static RenderFragment ContentCell(Estimate? estimate, RosterCount? seen, int cap) => builder =>
    {
        if (estimate is not { } value || seen is null)
        {
            builder.AddMarkupContent(0, "<span class=\"muted\">?</span>");
            return;
        }
        builder.OpenElement(1, "span");
        builder.AddAttribute(2, "class", value.Gained > 0 ? "estimate" : string.Empty);
        builder.AddContent(3, RosterText.Count(value));
        builder.CloseElement();
        var extra = RosterText.Extra(seen.Second, always: false);
        if (extra.Length > 0)
        {
            builder.OpenElement(4, "span");
            builder.AddAttribute(5, "class", "muted");
            builder.AddContent(6, " " + extra);
            builder.CloseElement();
        }
        builder.OpenElement(7, "span");
        builder.AddAttribute(8, "class", "muted");
        builder.AddContent(9, RosterText.OutOf(cap, afterExtra: extra.Length > 0));
        builder.CloseElement();
    };
}
