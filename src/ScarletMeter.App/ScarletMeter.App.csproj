<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- The meter window: WPF hosting a Blazor WebView whose pages are Scarlet Meter's own. It references the
       engine only; the upstream boundary test fails if an upstream project reference appears here. -->

  <!-- Test seams (a settings save held, SettingsService) stay internal, out of the app's surface and of dependency
       injection's choice of constructors. -->
  <ItemGroup>
    <InternalsVisibleTo Include="ScarletMeter.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- A Windows 10 SDK version, not plain net10.0-windows: BlazorWebView draws the see-through overlay with
         WebView2's composition control, which needs the Windows SDK projection (Microsoft.Windows.SDK.NET) at run
         time; without it the published exe crashed on start (THIRD-PARTY-NOTICES.md, ThirdPartyNoticesTests). -->
    <TargetFramework>net10.0-windows10.0.20348.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
    <UseRazorSourceGenerator>true</UseRazorSourceGenerator>
    <AssemblyName>ScarletMeter</AssemblyName>
    <RootNamespace>ScarletMeter.App</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- The exe's icon (Explorer, shortcuts), which every window also shows: WPF gives a window that sets no Icon
         the exe's own. Its source is in THIRD-PARTY-NOTICES.md, "Artwork". -->
    <ApplicationIcon>Assets\ScarletMeter.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.2" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ScarletMeter.Engine/ScarletMeter.Engine.csproj" />
    <ProjectReference Include="../ScarletMeter.WorldEvents/ScarletMeter.WorldEvents.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Class icons from upstream's UI project (read from the submodule, never edited), copied beside the
         executable and served to the pages through the assets.scarlet.example virtual host
         (Windows/WebAssetHosts.cs). A wildcard, so a renamed folder upstream drops icons, not the build;
         scripts/Test-PublishLayout.ps1 checks they were published. -->
    <None Include="$(ScarletUpstreamRoot)AionDpsMeter.UI/wwwroot/images/classes/*.png"
          Link="assets/classes/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- What a release must carry beside the executable (GPLv3, credits, how to run it), published loose so a player
         can read them; scripts/Test-PublishLayout.ps1 checks they are there. -->
    <None Include="../../LICENSE" Link="LICENSE.txt" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="../../NOTICE" Link="NOTICE.txt" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="Release/README.txt" Link="README.txt" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <!-- The licence texts and the packages' own notices (THIRD-PARTY-NOTICES.md, "Licence texts"). -->
    <None Include="../../licenses/**/*" Link="licenses/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- A self-contained publish bundles the .NET runtime packs, so their own licence and third-party notices go beside
       the executable too, under licenses/runtime/<pack>, copied from the very packs this publish resolved (their
       package folders, from the SDK's ResolvedRuntimePack items), so they always match the bundled runtime.
       scripts/Test-PublishLayout.ps1 checks the core runtime's are there. -->
  <Target Name="PublishRuntimePackNotices" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(SelfContained)' == 'true'">
    <ItemGroup>
      <_ScarletRuntimeNotice Include="%(ResolvedRuntimePack.PackageDirectory)/LICENSE*;%(ResolvedRuntimePack.PackageDirectory)/THIRD-PARTY-NOTICES*"
                             Pack="%(ResolvedRuntimePack.Identity)"
                             Condition="'%(ResolvedRuntimePack.PackageDirectory)' != ''" />
      <ResolvedFileToPublish Include="@(_ScarletRuntimeNotice)"
                             RelativePath="licenses/runtime/%(_ScarletRuntimeNotice.Pack)/%(_ScarletRuntimeNotice.Filename)%(_ScarletRuntimeNotice.Extension)"
                             CopyToPublishDirectory="PreserveNewest"
                             ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>

  <!-- Stamps the pinned upstream release and Scarlet's commit into this assembly (read by Updates/BuildInfo.cs). -->
  <Import Project="$(MSBuildThisFileDirectory)Updates\BuildStamp.targets" />

</Project>
