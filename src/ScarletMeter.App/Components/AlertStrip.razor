@using ScarletMeter.App.Alerts
@using ScarletMeter.WorldEvents
@*
    The overlay's world-event notices: a slim strip at the bottom of the meter. "Soon" counts down to the
    start with a bar that fills over the lead time; "Open" counts down to the end of the entry or portal
    window. Two notices show; the rest are summarised as "+N more", which lists them on hover and expands the
    strip to show all of them with their countdowns when clicked ("Show less" collapses it again, and it
    collapses by itself once the extra events have passed; AlertStripLayout). Countdowns use the time the parent
    passes in, so they tick with the overlay's own refresh. Screen readers hear only the hidden summary, which
    changes when a notice appears or changes kind, not every second. It is always rendered (empty when nothing
    is due), because a live region inserted already filled is often not announced. While Held (the notices stand
    aside for a boss fight) it shows nothing and its live region is empty, so what came due meanwhile is announced
    when the fight ends; the player's expanded choice is kept.
*@
<span class="sr-only" role="status">@(Held ? string.Empty : Announcement)</span>
@if (Held)
{
    @* Standing aside for a boss fight. *@
}
else if (View.Alerts.Count > 0)
{
    <div class="alerts @(expanded ? "expanded" : "")" aria-label="World event alerts">
        @foreach (var alert in AlertStripLayout.Shown(View.Alerts, expanded))
        {
            var remaining = alert.Deadline - Now;
            <div class="alert @Kind(alert)" @key="@($"{alert.Rule.Id}-{alert.Kind}-{alert.Start.UtcTicks}")"
                 title="@AlertStripLayout.Describe(alert)">
                <span class="alert-dot"></span>
                <span class="alert-name">@alert.Rule.Name</span>
                <span class="alert-when">
                    @if (alert.Kind == AlertKind.Soon)
                    {
                        <text>in @EventText.Countdown(remaining)</text>
                    }
                    else
                    {
                        <text>@EventText.OpenLabel(alert.Rule) · @EventText.Countdown(remaining) left</text>
                    }
                </span>
                <span class="alert-progress" style="width:@Compact.Percent(Progress(alert, remaining))"></span>
            </div>
        }
        @if (AlertStripLayout.HiddenCount(View.Alerts) is var hidden && hidden > 0)
        {
            <button type="button" class="alert more" aria-expanded="@(expanded ? "true" : "false")"
                    title="@(expanded ? AlertStripLayout.CollapseHint : AlertStripLayout.HiddenSummary(View.Alerts))"
                    @onclick="() => expanded = !expanded">
                @(expanded ? "Show less" : $"+{hidden} more")
            </button>
        }
    </div>
}
else if (View.Next is { } next)
{
    <div class="alerts">
        <div class="alert next" title="@next.Rule.Location">
            <span class="alert-dot"></span>
            <span class="alert-name">Next: @next.Rule.Name</span>
            <span class="alert-when">@EventText.LocalTime(next.Start) · in @EventText.Countdown(next.Start - Now)</span>
        </div>
    </div>
}

@code {
    // The player's choice, kept across the overlay's refreshes while extra notices are due.
    private bool expanded;

    [Parameter, EditorRequired] public AlertView View { get; set; } = AlertView.None;

    [Parameter] public DateTimeOffset Now { get; set; }

    // The notices stand aside for a boss fight: nothing shows, and nothing is announced until they come back.
    [Parameter] public bool Held { get; set; }

    protected override void OnParametersSet() => expanded = AlertStripLayout.StaysExpanded(expanded, View.Alerts);

    private string Announcement => string.Join("; ", View.Alerts.Take(AlertStripLayout.CollapsedCount).Select(a => a.Kind == AlertKind.Soon
        ? $"{a.Rule.Name} starts at {EventText.LocalTime(a.Start)}"
        : $"{a.Rule.Name}: {EventText.OpenLabel(a.Rule)} until {EventText.LocalTime(a.Deadline)}"));

    private static string Kind(EventAlert alert) =>
        (alert.Kind == AlertKind.Open ? "open" : "soon") + " kind-" + alert.Rule.Kind.ToString().ToLowerInvariant();

    // Soon: how much of the lead time has passed. Open: how much of the window is left.
    private double Progress(EventAlert alert, TimeSpan remaining)
    {
        if (alert.Kind == AlertKind.Soon)
            return View.Lead.TotalSeconds > 0 ? (1 - remaining.TotalSeconds / View.Lead.TotalSeconds) * 100 : 100;
        var window = (alert.Deadline - alert.Start).TotalSeconds;
        return window > 0 ? remaining.TotalSeconds / window * 100 : 0;
    }
}
