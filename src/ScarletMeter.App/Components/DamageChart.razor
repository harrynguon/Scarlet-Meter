@using System.Globalization
@*
    A player's damage over the fight: cumulative DPS (filled) and per-second damage (line), with one lane per
    buff below. Plain SVG and CSS, no script: the plot stretches to its box (strokes do not scale), axis labels
    are HTML positioned in percent, and hovering a column shows its values through the SVG title tooltip.
*@
@if (Data is null || Data.Points.Count < 2)
{
    <div class="chart-empty">No combat data yet.</div>
}
else
{
    <div class="chart">
        <div class="chart-legend">
            <span class="key cumulative">Cumulative DPS</span>
            <span class="key per-second">Damage per second</span>
        </div>
        <div class="chart-plot">
            <div class="y-labels">
                @foreach (var tick in yTicks)
                {
                    <span style="top:@Pct(100 - tick / yMax * 100)">@Compact.Number(tick)</span>
                }
            </div>
            <div class="plot-area">
                <svg viewBox="0 0 @Width @Height" preserveAspectRatio="none" aria-hidden="true">
                    @foreach (var tick in yTicks)
                    {
                        <line class="grid" x1="0" x2="@Width" y1="@Y(tick)" y2="@Y(tick)" />
                    }
                    <path class="area" d="@areaPath" />
                    <path class="cumulative" d="@cumulativePath" />
                    <path class="per-second" d="@perSecondPath" />
                    @foreach (var column in columns)
                    {
                        <rect class="hover" x="@F(column.X)" y="0" width="@F(column.Width)" height="@Height"><title>@column.Tip</title></rect>
                    }
                </svg>
                <div class="x-labels">
                    @foreach (var second in xTicks)
                    {
                        <span style="left:@Pct(second / Data.TotalSeconds * 100)">@Clock(second)</span>
                    }
                </div>
            </div>
        </div>

        @if (Data.Lanes.Count > 0)
        {
            <div class="lanes">
                @foreach (var lane in Data.Lanes.Take(MaxLanes))
                {
                    <div class="lane" title="@lane.Name · x@(lane.Count) · @lane.UptimePercent.ToString("0.#", CultureInfo.InvariantCulture)% uptime">
                        <span class="lane-name">
                            @if (SkillIcons.Url(lane.Icon) is { } icon)
                            {
                                <img src="@icon" alt="" />
                            }
                            @lane.Name
                        </span>
                        <span class="lane-track">
                            @foreach (var (start, end) in lane.Spans)
                            {
                                <i style="left:@Pct(start / Data.TotalSeconds * 100);width:@Pct(Math.Max(0.4, (end - start) / Data.TotalSeconds * 100))"></i>
                            }
                        </span>
                        <span class="lane-uptime">@lane.UptimePercent.ToString("0", CultureInfo.InvariantCulture)%</span>
                    </div>
                }
                @if (Data.Lanes.Count > MaxLanes)
                {
                    <div class="lane-more">+@(Data.Lanes.Count - MaxLanes) more buffs</div>
                }
            </div>
        }
    </div>
}

@code {
    private const double Width = 1000;
    private const double Height = 260;
    private const int MaxColumns = 240;
    private const int MaxLanes = 10;

    private double yMax = 1;
    private double[] yTicks = [];
    private double[] xTicks = [];
    private string areaPath = "";
    private string cumulativePath = "";
    private string perSecondPath = "";
    private List<(double X, double Width, string Tip)> columns = [];

    [Parameter] public ChartData? Data { get; set; }

    // Geometry is computed once per new data object, not on every render.
    private ChartData? computedFor;

    protected override void OnParametersSet()
    {
        if (Data is null || ReferenceEquals(Data, computedFor) || Data.Points.Count < 2) return;
        computedFor = Data;
        var points = Data.Points;
        var total = Math.Max(Data.TotalSeconds, points[^1].Second);
        var peak = points.Max(p => Math.Max(p.PerSecond, p.Cumulative));
        yMax = NiceCeiling(Math.Max(1, peak));
        yTicks = Enumerable.Range(0, 5).Select(i => yMax * i / 4).ToArray();
        var step = total > 900 ? 120 : total > 300 ? 60 : total > 120 ? 30 : total > 60 ? 10 : 5;
        xTicks = Enumerable.Range(0, (int)(total / step) + 1).Select(i => (double)(i * step)).Where(s => s <= total).ToArray();

        double X(double second) => second / total * Width;
        string Line(Func<ChartPoint, double> value) =>
            string.Join(' ', points.Select((p, i) => $"{(i == 0 ? 'M' : 'L')}{F(X(p.Second))},{F(Y(value(p)))}"));
        cumulativePath = Line(p => p.Cumulative);
        perSecondPath = Line(p => p.PerSecond);
        areaPath = $"{cumulativePath} L{F(X(points[^1].Second))},{F(Height)} L{F(X(points[0].Second))},{F(Height)} Z";

        // Hover columns: at most MaxColumns, each covering a run of points, titled with the run's last values.
        var perColumn = Math.Max(1, (int)Math.Ceiling(points.Count / (double)MaxColumns));
        columns = [];
        for (var i = 0; i < points.Count; i += perColumn)
        {
            var last = points[Math.Min(points.Count - 1, i + perColumn - 1)];
            var from = X(points[i].Second);
            var to = i + perColumn < points.Count ? X(points[i + perColumn].Second) : Width;
            columns.Add((from, Math.Max(1, to - from), $"{Clock(last.Second)} · {Compact.Number(last.PerSecond)}/s · cumulative {Compact.Number(last.Cumulative)}/s"));
        }
    }

    private double Y(double value) => Height - Math.Clamp(value / yMax, 0, 1) * Height;

    // 1, 2 or 5 times a power of ten, at or above the value.
    private static double NiceCeiling(double value)
    {
        var magnitude = Math.Pow(10, Math.Floor(Math.Log10(value)));
        foreach (var factor in new[] { 1.0, 2, 2.5, 5, 10 })
            if (factor * magnitude >= value) return factor * magnitude;
        return 10 * magnitude;
    }

    private static string F(double value) => value.ToString("0.#", CultureInfo.InvariantCulture);

    private static string Pct(double value) => Math.Clamp(value, 0, 100).ToString("0.##", CultureInfo.InvariantCulture) + "%";

    private static string Clock(double seconds) => $"{(int)(seconds / 60)}:{(int)(seconds % 60):00}";
}
